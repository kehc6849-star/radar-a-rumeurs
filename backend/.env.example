# Copy this file to ".env" and fill in your own values.
# The ".env" file is ignored by Git. NEVER publish a real key.

# Key created at https://aistudio.google.com/apikey (required for AI analysis)
GEMINI_API_KEY=

# Models (Gemma 4 through the Gemini API)
AI_MODEL=gemma-4-26b-a4b-it
AI_FALLBACK_MODEL=gemma-4-31b-it

# Leave empty to disable the "thinking" option (use "minimal" to keep answers fast)
AI_THINKING_LEVEL=minimal

# Optional shared token: the mobile app sends it in the X-Radar-Access-Token header.
# It is a speed bump against casual abuse, not a strong secret.
APP_ACCESS_TOKEN=

# Quota protection (see docs/11_AI_QUOTAS_AND_LIMITS.md)
CLIENT_REQUESTS_PER_MINUTE=10
GLOBAL_REQUESTS_PER_MINUTE=12
CACHE_TIME_TO_LIVE_SECONDS=3600

# Set to true only on your own machine to see the interactive API documentation
ENABLE_API_DOCUMENTATION=false
